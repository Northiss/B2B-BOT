# Скопируйте этот файл в .env и заполните своими значениями.
# Файл .env в git не попадает (см. .gitignore).

# Telegram: токен от @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Куда слать уведомления о лидах: ваш личный ID (число, узнать у @userinfobot)
# или ID группы (отрицательное число вида -100...)
MANAGERS_CHAT_ID=123456789

# Необязательно: прокси, если Telegram недоступен напрямую
# TELEGRAM_PROXY=http://127.0.0.1:7890

# Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key
# Необязательно: нужно, только если ключ не привязан к workspace
# ANTHROPIC_WORKSPACE_ID=your-workspace-id

# Google Sheets (CRM-lite)
GOOGLE_SHEET_ID=your-google-sheet-id
# Локально: путь к JSON-ключу сервисного аккаунта
GOOGLE_SHEETS_CREDS_FILE=./service-account.json
# На хостинге (Render): вместо файла — всё содержимое JSON одной переменной
# GOOGLE_CREDS_JSON={"type":"service_account", ...}
